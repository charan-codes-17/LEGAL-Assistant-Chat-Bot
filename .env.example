# Environment Configuration Template for Indian Legal Assistant Chatbot
# Copy this file to .env and add your valid API key(s)

# Primary LLM API Key (Groq API - Fast, OpenAI-compatible, no SDK dependency)
GROQ_API_KEY=your_groq_api_key_here

# Backup / Alternative LLM API Key (OpenRouter API - Access 100+ Models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Model Selection ---
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Generation Parameters ---
TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1024

# --- Retrieval Parameters ---
# Calibrated 2026-08: natural-language queries score ~0.10-0.22 cosine sim.
# Do not raise above ~0.12 without re-running the challenge-question test suite.
EVIDENCE_THRESHOLD=0.10
TOP_K_CHUNKS=3

# App Configurations
# NOTE: currently unused by app.py/llm.py — see dead-code decision (prompts.py/config.py)
FALLBACK_TO_OFFLINE_DEMO=true